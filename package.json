{
  "name": "openskidata-processor",
  "version": "1.0.0",
  "description": "Data pipeline for processing OpenStreetMap and Skimap.org data into OpenSkiData and OpenSkiMap tiles",
  "type": "module",
  "main": "run.sh",
  "prettier": {},
  "dependencies": {
    "@ngageoint/geopackage": "^4.2.9",
    "@turf/along": "^7.4.0",
    "@turf/bbox-polygon": "^7.4.0",
    "@turf/boolean-contains": "^7.4.0",
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/boolean-valid": "^7.4.0",
    "@turf/centroid": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/nearest-point": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.2",
    "dataloader": "^2",
    "date-fns": "^4.4.0",
    "iso3166-2-db": "^2",
    "ngeohash": "^0.6.4",
    "object-hash": "^3",
    "openskidata-format": "^15.0.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "stream-chain": "^4.2.5",
    "stream-json": "^3.6.0",
    "topojson-client": "^3",
    "topojson-server": "^3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/geojson": "^7946",
    "@types/ngeohash": "^0.6.2",
    "@types/node": "^24.13.3",
    "@types/object-hash": "^3",
    "@types/pg": "^8.23.1",
    "@types/topojson-client": "^3",
    "@types/topojson-server": "^3",
    "@types/topojson-specification": "^1.0.5",
    "concurrently": "^10.0.5",
    "nock": "^14.0.17",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "dev:all": "concurrently \"npm run dev\" \"/usr/local/bin/init-postgres.sh\"",
    "format": "prettier --write . --ignore-path .gitignore",
    "test": "vitest run",
    "record-tests": "vitest run -u",
    "check-types": "tsc --project tsconfig.typecheck.json",
    "download": "node --optimize_for_size --max_old_space_size=${MAX_OLD_SPACE_SIZE:-4096} dist/scripts/download.js",
    "prepare-geojson": "node --optimize_for_size --max_old_space_size=${MAX_OLD_SPACE_SIZE:-4096} dist/scripts/prepare_geojson.js",
    "debug-geocode": "node dist/scripts/debug_geocode.js",
    "merge-outputs": "node dist/scripts/merge_outputs.js",
    "extract-tiles": "node dist/scripts/extract_tiles.js",
    "clear-cache": "node dist/scripts/clear_cache.js",
    "smoke-import": "node scripts/smoke-import.mjs"
  },
  "author": "Russell Porter",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  }
}
